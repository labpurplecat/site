{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:3000} {
	encode gzip
	root * .
	# CORREÇÃO (13/09/2026): sem isso, URLs sem ".html" (como as que o backend
	# usa nos back_urls do Mercado Pago: /obrigado e /pagamento-recusado, e
	# também /minha-area) davam 404, mesmo com o arquivo .html existindo.
	try_files {path} {path}.html {path}/index.html
	file_server
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
	}
}
